--- /dev/null
+++ b/tests/test_agency_owner.py
@@ -0,0 +1,101 @@
+import json
+from pathlib import Path
+import sqlite3
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from founder_crm.core import Store, CRMError
+
+
+class OwnerTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.path = Path(self.tmp.name) / "crm.db"
+
+    def test_upgrade_preserves_populated_v1_database_and_is_idempotent(self):
+        with sqlite3.connect(self.path) as c:
+            c.executescript(
+                Path(__file__)
+                .with_name("fixtures")
+                .joinpath("schema-v1.sql")
+                .read_text()
+            )
+            c.execute(
+                "INSERT INTO accounts(name,relationship,lifecycle) VALUES('Existing client','customer','active')"
+            )
+            c.execute(
+                "INSERT INTO contacts(account_id,name,email) VALUES(1,'Example Person','person@agency.example')"
+            )
+            c.execute(
+                "INSERT INTO tasks(account_id,title) VALUES(1,'Send the agreed brief')"
+            )
+        s = Store(self.path)
+        s.init()
+        s.init()
+        a = s.account_history(1)
+        self.assertEqual(a["name"], "Existing client")
+        self.assertIsNone(a["owner"])
+        self.assertEqual(a["contacts"][0]["email"], "person@agency.example")
+        self.assertEqual(a["tasks"][0]["title"], "Send the agreed brief")
+        with s.connection() as c:
+            self.assertEqual(
+                c.execute(
+                    "SELECT value FROM meta WHERE key='schema_version'"
+                ).fetchone()[0],
+                "2",
+            )
+
+    def test_owner_persists_and_is_available_in_dashboard_and_detail(self):
+        s = Store(self.path)
+        s.init()
+        id = s.add_account("Example Agency Client", "prospect", owner="  Maya  ")["id"]
+        self.assertEqual(s.account_history(id)["owner"], "Maya")
+        self.assertEqual(s.dashboard()["accounts"][0]["owner"], "Maya")
+        self.assertEqual(Store(self.path).account_history(id)["owner"], "Maya")
+
+    def test_unknown_owner_stays_null_and_invalid_values_are_rejected(self):
+        s = Store(self.path)
+        s.init()
+        for owner in (None, "", "   "):
+            id = s.add_account("No assigned owner", owner=owner)["id"]
+            self.assertIsNone(s.account_history(id)["owner"])
+        for owner in (True, 123, "x" * 201):
+            with self.assertRaises(CRMError):
+                s.add_account("Bad owner", owner=owner)
+
+    def test_positional_actor_contract_stays_compatible(self):
+        s = Store(self.path)
+        s.init()
+        s.add_account("Imported client", "prospect", "new", "importer")
+        self.assertEqual(s.dashboard()["audit"][0]["actor"], "importer")
+        self.assertIsNone(s.dashboard()["accounts"][0]["owner"])
+
+    def test_cli_sets_owner_without_changing_audit_actor(self):
+        s = Store(self.path)
+        s.init()
+        result = subprocess.run(
+            [
+                sys.executable,
+                "-m",
+                "founder_crm",
+                "--db",
+                str(self.path),
+                "account",
+                "CLI example",
+                "--owner",
+                "Maya",
+            ],
+            capture_output=True,
+            text=True,
+        )
+        self.assertEqual(result.returncode, 0, result.stderr)
+        id = json.loads(result.stdout)["id"]
+        self.assertEqual(s.account_history(id)["owner"], "Maya")
+        self.assertEqual(s.dashboard()["audit"][0]["actor"], "human")
+
+
+if __name__ == "__main__":
+    unittest.main()
