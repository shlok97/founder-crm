# Pass configuration in the environment. This file is not automatically loaded.
FOUNDER_CRM_DB=data/crm.db
# Pass --port to the serve command to change the default 4780.
# Generate your own long random token for Web3Forms intake. Never commit it.
FOUNDER_CRM_WEBHOOK_TOKEN=
# Optional Jev judge. No ambient credentials from other projects are loaded.
FOUNDER_CRM_ALLOW_MODEL_EGRESS=0
FOUNDER_CRM_JEV_PROVIDER=typesafe
# Leave empty to use your provider's default Jev model.
FOUNDER_CRM_JEV_MODEL=
FOUNDER_CRM_JEV_API_KEY=
# Optional read-only Gmail pull, explicitly invoked by a person or tool.
FOUNDER_CRM_GMAIL_ACCESS_TOKEN=
